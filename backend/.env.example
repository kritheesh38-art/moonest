# ---- Database ----
MONGO_URL=mongodb://localhost:27017      # unset in demo mode = in-memory test DB (resets on restart)
DB_NAME=moonest

# ---- Security ----
# Required when DEMO_MODE=false: 32+ random characters (python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=replace-with-a-long-random-string
# Starting value of demo mode; admins can switch it later in Admin → Overview (that choice wins).
# Demo mode shows OTPs on screen, simulates payments when Razorpay keys are empty, lets anyone sign up as an
# agent and enables Admin → "Run tomorrow's deliveries today". Turn OFF in production.
DEMO_MODE=true
# Demo accounts (password pass1234): agent@moonest.in, customer@moonest.in. Turn OFF in production.
SEED_DEMO_DATA=true

# ---- Admins ----
# Only these usernames can use Admin (username + password; no OTP). Re-applied on every start:
# the accounts are created/updated and nobody else keeps admin access.
ADMIN_USERS=ritissh,kritheesh,subhasree
ADMIN_PASSWORD=                          # set it here or in your host's secret settings; never commit it

# ---- Web ----
CORS_ORIGINS=*                           # your app's origin(s), comma-separated, if the API is on another domain
FRONTEND_DIST=                           # path to frontend/dist-server to serve the app from this server
PUBLIC_BASE_URL=                         # prefix for delivery-photo links (empty = relative /api/uploads/...)
UPLOAD_DIR=                              # where delivery photos are stored (default backend/uploads)
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse   # "Use my current location" address lookup; empty = off
PHOTON_URL=https://photon.komoot.io/reverse                # second lookup service; empty = off
# Address search as you type: the most precise for India. Set one (otherwise free OpenStreetMap search).
GOOGLE_MAPS_API_KEY=   # Google Cloud: enable "Places API (New)"
OLA_MAPS_API_KEY=      # Ola Maps (maps.olakrutrim.com)

# ---- Razorpay (test keys: https://dashboard.razorpay.com/app/keys) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Twilio SMS (OTP + delivery notifications) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Route start point (depot) ----
DEPOT_LAT=12.9352
DEPOT_LNG=77.6245
